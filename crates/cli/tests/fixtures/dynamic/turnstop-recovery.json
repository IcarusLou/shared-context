{
  "schema": "shared-context.dynamic-scenario",
  "version": "1",
  "name": "turnstop_repeat_and_mcp_restart_recovery",
  "agent": {"vendor": "codex", "version": "0.147.0", "framing": "content_length"},
  "actors": [
    {"id": "session", "kind": {"type": "session"}},
    {"id": "task", "kind": {"type": "task", "session": "session"}}
  ],
  "actions": [
    {
      "id": "repository-add", "actor": "task", "after": [],
      "action": {"type": "cli_json", "arguments": [
        {"type": "string", "value": "repository"},
        {"type": "string", "value": "add"},
        {"type": "string", "value": "--repository-id"},
        {"type": "string", "value": "FE"},
        {"type": "string", "value": "--path"},
        {"type": "builtin", "builtin": {"type": "resource_root", "resource": "focus-repo"}}
      ]}
    },
    {
      "id": "session-start", "actor": "session", "after": ["repository-add"],
      "action": {"type": "hook_event", "event": "SessionStart", "payload": {"type": "object", "fields": {
        "cwd": {"type": "builtin", "builtin": {"type": "resource_root", "resource": "focus-repo"}},
        "source": {"type": "string", "value": "startup"}
      }}}
    },
    {
      "id": "out-of-order-stop", "actor": "session", "after": ["session-start"],
      "action": {"type": "hook_event", "event": "Stop", "payload": {"type": "object", "fields": {}}}
    },
    {
      "id": "intent-new", "actor": "task", "after": ["out-of-order-stop"],
      "action": {"type": "mcp_request", "method": "task_intent_update", "params": {"type": "object", "fields": {
        "agent_kind": {"type": "string", "value": "codex"},
        "external_session_id": {"type": "builtin", "builtin": {"type": "actor_session_key", "actor": "session"}},
        "task_boundary": {"type": "string", "value": "new"},
        "expected_revision_id": {"type": "null"},
        "intent": {"type": "object", "fields": {"goal": {"type": "string", "value": "exercise deterministic Stop and restart recovery"}}}
      }}}
    },
    {
      "id": "context-before-crash", "actor": "task", "after": ["intent-new"],
      "action": {"type": "mcp_request", "method": "task_context", "params": {"type": "object", "fields": {
        "agent_kind": {"type": "string", "value": "codex"},
        "external_session_id": {"type": "builtin", "builtin": {"type": "actor_session_key", "actor": "session"}},
        "token_budget": {"type": "unsigned", "value": 32768},
        "max_spaces": {"type": "unsigned", "value": 5}
      }}}
    },
    {
      "id": "restart", "actor": "session", "after": ["context-before-crash"],
      "action": {"type": "restart"}
    },
    {
      "id": "checkpoint", "actor": "task", "after": ["restart"],
      "action": {"type": "mcp_request", "method": "task_checkpoint", "params": {"type": "object", "fields": {
        "agent_kind": {"type": "string", "value": "codex"},
        "external_session_id": {"type": "builtin", "builtin": {"type": "actor_session_key", "actor": "session"}},
        "expected_task_id": {"type": "variable", "name": "task-id"},
        "expected_intent_revision_id": {"type": "variable", "name": "revision-id"},
        "expected_episode_version": {"type": "unsigned", "value": 0},
        "boundary": {"type": "string", "value": "continue"},
        "claims": {"type": "array", "items": [{"type": "object", "fields": {
          "context_kind_hint": {"type": "string", "value": "validation"},
          "topic_key_hint": {"type": "string", "value": "testing/restart"},
          "statement": {"type": "string", "value": "A restarted protocol retains the synthetic ActiveTask"},
          "rationale": {"type": "string", "value": "The next checkpoint uses only captured server identities"},
          "applicability": {"type": "object", "fields": {
            "domains": {"type": "array", "items": [{"type": "string", "value": "testing"}]},
            "platforms": {"type": "array", "items": []},
            "conditions": {"type": "array", "items": []}
          }},
          "assumptions": {"type": "array", "items": []},
          "recheck_when": {"type": "array", "items": [{"type": "string", "value": "the restart protocol changes"}]},
          "evidence": {"type": "array", "items": [{"type": "object", "fields": {
            "kind": {"type": "string", "value": "inline_validation"},
            "evidence": {"type": "object", "fields": {
              "kind": {"type": "string", "value": "experiment_record"},
              "supports": {"type": "string", "value": "the restarted checkpoint completed"},
              "content": {"type": "object", "fields": {"actual": {"type": "string", "value": "passed"}}},
              "interpretation": {"type": "string", "value": "the protocol state survived transport recovery"},
              "limitations": {"type": "array", "items": [{"type": "string", "value": "synthetic offline fixture"}]}
            }}
          }}]},
          "artifact_refs": {"type": "array", "items": []},
          "related_contexts": {"type": "array", "items": []}
        }}]},
        "unknowns": {"type": "array", "items": []}
      }}}
    },
    {
      "id": "first-stop", "actor": "session", "after": ["checkpoint"],
      "action": {"type": "hook_event", "event": "Stop", "payload": {"type": "object", "fields": {}}}
    },
    {
      "id": "first-list", "actor": "task", "after": ["first-stop"],
      "action": {"type": "mcp_request", "method": "candidate_list", "params": {"type": "object", "fields": {
        "agent_kind": {"type": "string", "value": "codex"},
        "external_session_id": {"type": "builtin", "builtin": {"type": "actor_session_key", "actor": "session"}},
        "status": {"type": "string", "value": "pending"},
        "limit": {"type": "unsigned", "value": 10},
        "token_budget": {"type": "unsigned", "value": 32768}
      }}}
    },
    {
      "id": "repeated-stop", "actor": "session", "after": ["first-list"],
      "action": {"type": "hook_event", "event": "Stop", "payload": {"type": "object", "fields": {}}}
    },
    {
      "id": "repeated-list", "actor": "task", "after": ["repeated-stop"],
      "action": {"type": "mcp_request", "method": "candidate_list", "params": {"type": "object", "fields": {
        "agent_kind": {"type": "string", "value": "codex"},
        "external_session_id": {"type": "builtin", "builtin": {"type": "actor_session_key", "actor": "session"}},
        "status": {"type": "string", "value": "pending"},
        "limit": {"type": "unsigned", "value": 10},
        "token_budget": {"type": "unsigned", "value": 32768}
      }}}
    },
    {
      "id": "candidate-get", "actor": "task", "after": ["repeated-list"],
      "action": {"type": "mcp_request", "method": "candidate_get", "params": {"type": "object", "fields": {
        "agent_kind": {"type": "string", "value": "codex"},
        "external_session_id": {"type": "builtin", "builtin": {"type": "actor_session_key", "actor": "session"}},
        "candidate_id": {"type": "variable", "name": "repeated-candidate-id"}
      }}}
    }
  ],
  "resources": [{
    "id": "focus-repo", "synthetic_git": true,
    "files": [{"path": "README.txt", "content": "synthetic Stop recovery activation repository\n"}]
  }],
  "variables": [
    {"name": "task-id", "value_type": "task_id", "capture": {"step": "intent-new", "pointer": "/task_id"}},
    {"name": "revision-id", "value_type": "intent_revision_id", "capture": {"step": "intent-new", "pointer": "/intent_revision_id"}},
    {"name": "checkpoint-episode-id", "value_type": "work_episode_id", "capture": {"step": "checkpoint", "pointer": "/episode_id"}},
    {"name": "first-candidate-id", "value_type": "candidate_id", "capture": {"step": "first-list", "pointer": "/reviews/0/candidate_id"}},
    {"name": "repeated-candidate-id", "value_type": "candidate_id", "capture": {"step": "repeated-list", "pointer": "/reviews/0/candidate_id"}},
    {"name": "candidate-id", "value_type": "candidate_id", "capture": {"step": "candidate-get", "pointer": "/candidate_id"}},
    {"name": "episode-id", "value_type": "work_episode_id", "capture": {"step": "candidate-get", "pointer": "/source_episode/episode_id"}}
  ],
  "faults": [
    {"id": "persistent-crash", "fault": {"type": "crash", "target": "context-before-crash", "actor": "task", "timing": "after"}}
  ],
  "assertions": [
    {"id": "stop-is-idempotent", "invariant": {"type": "turn_stop_is_idempotent", "first_stop": "first-stop", "repeated_stop": "repeated-stop", "first_candidate": "first-candidate-id", "repeated_candidate": "repeated-candidate-id"}},
    {"id": "recovered-candidate-source", "invariant": {"type": "candidate_source_episode", "response": "candidate-get", "candidate": "candidate-id", "episode": "episode-id"}}
  ],
  "events": [
    {"event": "SessionStart", "classification": "supported", "product_action": "session_start"},
    {"event": "Stop", "classification": "supported", "product_action": "turn_stop"}
  ]
}
