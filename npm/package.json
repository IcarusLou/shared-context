{
  "name": "@bytedance-dev/shared-context-npm-packaging",
  "private": true,
  "version": "0.2.0-dev.8",
  "scripts": {
    "install:local": "node scripts/install-local.js",
    "install:release": "node scripts/install-release.js",
    "release:prepare": "node scripts/prepare-release.js",
    "release:publish": "node scripts/publish-release.js",
    "release:test": "npm run release:prepare && npm run install:release",
    "release:version": "node scripts/set-release-version.js",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=18"
  }
}
